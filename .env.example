# Set a random secret before hosting outside localhost.
SECRET_KEY=replace-with-a-long-random-value
# Optional absolute path for SQLite; default is instance/fitness.db
# DATABASE_PATH=C:/path/to/coach.sqlite3
# Set COOKIE_SECURE=true only when serving over HTTPS.
COOKIE_SECURE=false
# Optional server-side OpenAI chat integration; local rules remain available.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
