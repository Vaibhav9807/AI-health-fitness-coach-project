# Application Secret Key
SECRET_KEY=replace-with-a-long-random-value

# Optional custom SQLite database path (default is instance/fitness.db)
# DATABASE_PATH=C:/path/to/fitness.db

# Set COOKIE_SECURE=true only when serving over HTTPS
COOKIE_SECURE=false

# Optional server-side OpenAI chat integration; local rule-based fallback remains active
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional SMTP Settings for Password Recovery (e.g. Gmail, SendGrid, Outlook, Mailtrap)
# In local development without SMTP, password reset links are safely displayed in the local developer console / UI
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@healthcoach.local
# SMTP_USE_TLS=true
